# Database Configuration
# Local SQLite (Development):
# DATABASE_URL="file:./dev.db"
#
# Remote / Production MySQL (Target cruz.my.id):
DATABASE_URL="mysql://username:password@hostname:3306/cruz_db"

# NextAuth / Auth.js Secret (generate with: npx auth secret)
AUTH_SECRET="your-32-char-random-secret"

# Canonical URL
# Local: http://localhost:3000
# Production:
AUTH_URL="https://cruz.my.id"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
AUTH_GOOGLE_ID="your_google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# Developer Emails authorized to access /admin (comma-separated)
ADMIN_EMAILS="developer@cruz.my.id,admin@example.com"
